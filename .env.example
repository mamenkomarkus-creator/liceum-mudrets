# Public address of the site (used for canonical links, sitemap, robots and social previews).
NEXT_PUBLIC_SITE_URL=https://liceum-mudrets.com.ua

# Where readers' articles are sent (mailto link on the home page and Contacts).
NEXT_PUBLIC_EDITORIAL_EMAIL=statelic@ukr.net

# ── Редакційна панель (/redakciya) ──────────────────────────────────────────
# Хто може входити. Хеш пароля: npm run redakciya:password -- "пароль"
# role: "chief" — може публікувати випуск, "editor" — додає й редагує статті.
REDAKCIYA_USERS='[{"login":"mark","name":"Марк Маменко","role":"chief","password":"scrypt:..."},{"login":"danylo","name":"Данило Школяр","role":"editor","password":"scrypt:..."}]'
# Будь-який випадковий рядок від 16 символів (підписує вхід). Зміна — усіх розлогінить.
REDAKCIYA_SECRET=

# Сховище файлів статей. Vercel додає їх сам, коли створити Blob Store (тип Private) і підключити до проєкту:
# BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (доступ через OIDC) або, у старіших сховищах, BLOB_READ_WRITE_TOKEN.
# Без них (локально) файли лежать у папці .redakciya/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Ключ Claude API (console.anthropic.com) — обробка статей. Без нього буде лише проста чернетка.
ANTHROPIC_API_KEY=

# Публікація випуску: коміт у GitHub, після якого Vercel перезбирає сайт.
# Fine-grained token лише для цього репозиторію з дозволом Contents: Read and write.
# Без токена (локально) публікація записує файли прямо в проєкт.
GITHUB_TOKEN=
GITHUB_REPO=mamenkomarkus-creator/liceum-mudrets
GITHUB_BRANCH=main
